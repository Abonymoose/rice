configuration {
    modi: "drun";
    show-icons: false;
    display-drun: "Apps";
    drun-display-format: "{name}";
    font: "monospace 11";
}

* {
    background:     #1a1a1ad9;
    background-alt: #2a2a2a;
    foreground:     #cccccc;
    selected:       #cccccc;
    border-color:   #2a2a2a;

    background-color: @background;
    text-color:        @foreground;
}

window {
    width: 30%;
    background-color: @background;
    border-width: 1px;
    border-color: @border-color;
    border-radius: 8px;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @background-alt;
    text-color: @foreground;
    padding: 8px;
    border-radius: 8px;
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @foreground;
    font: "monospace 11";
    placeholder: "Search apps...";
    placeholder-color: @background-alt;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @foreground;
    padding: 6px;
    border-radius: 8px;
}

element selected {
    background-color: @background-alt;
    text-color: @selected;
    border: 1px;
    border-color: @border-color;
}

/* rofi's built-in default theme defines the more specific
   "element selected.<state>" selectors (using Solarized blue/red/tan
   variables), which win over the generic "element selected" rule
   above for the actual runtime state of a highlighted entry. These
   overrides pin every state to the B/W palette. */
element selected.normal {
    background-color: @background-alt;
    text-color: @selected;
}

element selected.active {
    background-color: @background-alt;
    text-color: @selected;
}

element selected.urgent {
    background-color: @background-alt;
    text-color: @selected;
}

/* Same issue for unselected rows: rofi alternates "normal" and
   "alternate" row states for zebra-striping, and the base theme's
   alternate.* selectors default to a cream/tan background. Pin them
   transparent (same as the plain "element" rule) so every row reads
   as flat B/W regardless of index or urgency state. */
element normal.normal, element normal.active, element normal.urgent,
element alternate.normal, element alternate.active, element alternate.urgent {
    background-color: transparent;
    text-color: @foreground;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "monospace 11";
    vertical-align: 0.5;
}
