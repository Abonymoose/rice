configuration {
    modi: "drun";
    show-icons: false;
    display-drun: "Apps";
    drun-display-format: "{name}";
    font: "monospace 11";
}

* {
    background:     #1a1a1ad9;
    background-alt: #2a2a2a;
    foreground:     #cccccc;
    border-color:   #2a2a2a;

    background-color: @background;
    text-color:        @foreground;
}

window {
    width: 30%;
    background-color: @background;
    border-width: 1px;
    border-color: @border-color;
    border-radius: 8px;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @background-alt;
    text-color: @foreground;
    padding: 8px;
    border-radius: 8px;
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @foreground;
    font: "monospace 11";
    placeholder: "Search apps...";
    placeholder-color: @foreground;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    border: 0px;
}

element {
    background-color: transparent;
    text-color: @foreground;
    padding: 6px;
    border-radius: 8px;
}

/* rofi's built-in default theme defines the more specific
   "element selected.<state>" / "element (normal|alternate).<state>"
   selectors, which win over a plain "element"/"element selected"
   rule for the actual runtime state of a row - without these, rows
   leak the default theme's colors instead of this palette. */
element selected,
element selected.normal, element selected.active, element selected.urgent {
    background-color: @background-alt;
    text-color: @foreground;
    border: 1px;
    border-color: @border-color;
}

element normal.normal, element normal.active, element normal.urgent,
element alternate.normal, element alternate.active, element alternate.urgent {
    background-color: transparent;
    text-color: @foreground;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "monospace 11";
    vertical-align: 0.5;
}
