# i3 config file (v4)
# rice - minimal B/W aesthetic, Alt (Mod1) key

set $mod Mod1

# Font
font pango:monospace 11

# Terminal
bindsym $mod+Return exec --no-startup-id xterm

# Rofi launcher
bindsym $mod+space exec rofi -show drun

# Kill window
bindsym $mod+Shift+q kill

# WASD window focus
bindsym $mod+a focus left
bindsym $mod+s focus down
bindsym $mod+w focus up
bindsym $mod+d focus right

# WASD window movement
bindsym $mod+Shift+a move left
bindsym $mod+Shift+s move down
bindsym $mod+Shift+w move up
bindsym $mod+Shift+d move right

# Workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5

# Move to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5

# Split
bindsym $mod+h split horizontal
bindsym $mod+v split vertical

# Layout: default (tiling) / stacked (full height) / tabbed
bindsym $mod+e layout toggle split stacking tabbed

# Fullscreen
bindsym $mod+f fullscreen toggle

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+Tab focus mode_toggle

# i3 control
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes' 'i3-msg exit'"

# Volume keys
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# Colors (class border background text indicator child_border) - minimal B/W
client.focused          #cccccc #000000 #ffffff #cccccc #cccccc
client.unfocused        #333333 #000000 #cccccc #333333 #333333
client.focused_inactive #333333 #000000 #cccccc #333333 #333333
client.urgent           #ffffff #000000 #ffffff #ffffff #ffffff

# Autostart
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id killall polybar; polybar main
exec_always --no-startup-id killall picom; picom -b --config ~/.config/picom/picom.conf
exec_always --no-startup-id feh --bg-scale ~/.config/rice/wallpaper/creation-of-adam.png

# Gaps
gaps inner 8
gaps outer 0
workspace_layout default
