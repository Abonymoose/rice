# i3 config file (v4)
# rice - Void Linux i3 setup, Phase 1: Foundation

set $mod Mod4

# Font used for window titles
font pango:monospace 10

# Start a terminal
bindsym $mod+Return exec --no-startup-id alacritty

# Open lf (terminal file manager) in a new terminal
bindsym $mod+e exec alacritty -e lf

# Launch apps with rofi
bindsym $mod+space exec rofi -show drun

# Bluetooth / volume menus (also discoverable via rofi drun as
# "Bluetooth Manager" / "Volume Manager")
bindsym $mod+Shift+b exec ~/.config/rofi/scripts/bluetooth-menu.sh
bindsym $mod+Shift+v exec ~/.config/rofi/scripts/volume-menu.sh

# Apps
bindsym $mod+b exec firefox
bindsym $mod+n exec alacritty -e cmus
bindsym $mod+a exec alacritty -e cava
bindsym Control+Shift+Escape exec alacritty -e htop
bindsym $mod+d exec alacritty -e ncdu

# Kill focused window
bindsym $mod+w kill

# Change focus (arrow keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window (arrow keys)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Switch to workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5

# Split containers
bindsym $mod+h split horizontal
bindsym $mod+v split vertical

# Toggle fullscreen for the focused container
bindsym $mod+f fullscreen toggle

# Toggle floating for the focused window
bindsym $mod+Shift+space floating toggle

# Reload the config file
bindsym $mod+Shift+c reload

# Restart i3 in place (preserves layout/session)
bindsym $mod+Shift+r restart

# Exit i3 (log out), with a confirmation prompt
bindsym $mod+q exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes' 'i3-msg exit'"

# Autostart: merge X resources, launch the bar, launch the compositor,
# and set the wallpaper
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id killall polybar; polybar main
exec_always --no-startup-id killall -q picom 2>/dev/null; sleep 0.5; picom -b --config ~/.config/picom/picom.conf
exec_always --no-startup-id feh --bg-scale ~/.config/wallpaper/creation-of-adam.png

# Gaps between windows
gaps inner 8
gaps outer 0

# No i3bar - polybar replaces it
