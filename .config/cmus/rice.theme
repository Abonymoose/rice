# rice colorscheme - dark grey/black unified palette

# Window colors
set color_win_bg=0
set color_win_fg=7
set color_win_dir=7
set color_win_cur=7
set color_win_cur_sel_bg=8
set color_win_cur_sel_fg=7
set color_win_sel_bg=8
set color_win_sel_fg=7

# Title bar (column headers)
set color_win_title_bg=0
set color_win_title_fg=7

# Status/Command line
set color_statusline_bg=8
set color_statusline_fg=7
set color_titleline_bg=0
set color_titleline_fg=7
set color_cmdline_bg=0
set color_cmdline_fg=7

# Info/errors
set color_error=7
set color_info=7
set color_separator=8
