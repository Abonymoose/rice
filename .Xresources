! rice - minimal B/W xterm theme
! Transparency (opacity 0.85) is applied via picom's opacity-rule, not here.
xterm*background: #ffffff
xterm*foreground: #000000
xterm*cursorColor: #cccccc
xterm*cursorBlink: true

xterm*color0: #000000
xterm*color1: #333333
xterm*color2: #333333
xterm*color3: #333333
xterm*color4: #333333
xterm*color5: #333333
xterm*color6: #333333
xterm*color7: #cccccc
xterm*color8: #666666
xterm*color9: #000000
xterm*color10: #000000
xterm*color11: #000000
xterm*color12: #000000
xterm*color13: #000000
xterm*color14: #000000
xterm*color15: #ffffff

xterm*faceName: monospace
xterm*faceSize: 11
xterm*font: -xos4-terminus-medium-r-normal--14-140-72-72-c-80-iso10646-1
